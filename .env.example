DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scenepilot
AI_DEFAULT_PROVIDER=qwen
AI_DEFAULT_MODEL=qwen-plus
QWEN_API_KEY=
QWEN_BASE_URL=
ASSET_STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=

# Visual concept generation (server only)
IMAGE_AI_PROVIDER=qwen
IMAGE_AI_MODEL=qwen-image-2.0-pro
IMAGE_AI_CANDIDATE_COUNT=4
IMAGE_AI_REQUEST_TIMEOUT_MS=300000
# Optional when QWEN_API_KEY already has access to the configured Qwen Image model.
DASHSCOPE_API_KEY=
# Model Studio endpoint must match the API key and model region.
DASHSCOPE_BASE_URL=https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/api/v1

# Shot image-to-video generation (server only)
VIDEO_AI_PROVIDER=wan
VIDEO_AI_MODEL=wan2.7-i2v-2026-04-25
VIDEO_AI_RESOLUTION=720P
VIDEO_AI_DEFAULT_DURATION=5
VIDEO_AI_POLL_INTERVAL_SECONDS=15
VIDEO_AI_TASK_TIMEOUT_MINUTES=10
